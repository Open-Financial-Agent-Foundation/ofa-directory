# Public URL of this deployment; used in ai-catalog.json, llms.txt and the docs. Optional locally.
NEXT_PUBLIC_SITE_URL=https://openfinancialagent.org

# Submissions open a pull request on the registry as the project, so a submitter needs no GitHub
# account. Without these the form falls back to copying the file by hand.
# A fine-grained token with Contents: read and write, and Pull requests: read and write, on the
# registry repository only.
GITHUB_TOKEN=
# Defaults to Open-Financial-Agent-Foundation/ofa-directory and main.
OFA_REGISTRY_REPO=
OFA_REGISTRY_BRANCH=
